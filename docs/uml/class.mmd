
classDiagram
direction TB

namespace MODEL {
    class Aset {
        <<abstract>>
        -String kode
        -String nama
        -StatusAset status
        -Kondisi kondisi
        +Aset(String kode, String nama)
        +getKode() String
        +getNama() String
        +getStatus() StatusAset
        +getKondisi() Kondisi
        +setNama(String nama) void
        +setStatus(StatusAset status) void
        +setKondisi(Kondisi kondisi) void
        +bisaDipinjam() boolean
        +getJenis() JenisAset
        +hitungDenda(int hariTerlambat) long
        #hitungDendaDenganPengali(int hariTerlambat, int pengali) long
    }

    class Ruang {
        -int kapasitas
        +Ruang(String kode, String nama, int kapasitas)
        +getKapasitas() int
        +getJenis() JenisAset
        +hitungDenda(int hariTerlambat) long
    }

    class Laptop {
        -String spesifikasi
        -String nomorInventaris
        +Laptop(String kode, String nama, String spesifikasi, String nomorInventaris)
        +getSpesifikasi() String
        +getNomorInventaris() String
        +getJenis() JenisAset
        +hitungDenda(int hariTerlambat) long
    }

    class AlatLab {
        -String laboratorium
        -TingkatRisiko tingkatRisiko
        +AlatLab(String kode, String nama, String laboratorium, TingkatRisiko tingkatRisiko)
        +getLaboratorium() String
        +getTingkatRisiko() TingkatRisiko
        +getJenis() JenisAset
        +hitungDenda(int hariTerlambat) long
    }

    class Peminjam {
        <<record>>
        -String id
        -String nama
        +Peminjam(String id, String nama)
    }

    class Peminjaman {
        -String id
        -Peminjam peminjam
        -Aset aset
        -LocalDateTime mulai
        -LocalDateTime selesai
        -StatusPeminjaman status
        +Peminjaman(String id, Peminjam peminjam, Aset aset, LocalDateTime mulai, LocalDateTime selesai)
        +getId() String
        +getPeminjam() Peminjam
        +getAset() Aset
        +getMulai() LocalDateTime
        +getSelesai() LocalDateTime
        +getStatus() StatusPeminjaman
        +setStatusDariPenyimpanan(StatusPeminjaman status) void
        +ubahStatus(StatusPeminjaman baru) void
    }

    class StatusAset {
        <<enumeration>>
        TERSEDIA
        DIPINJAM
        RUSAK
    }

    class Kondisi {
        <<enumeration>>
        BAIK
        RUSAK_RINGAN
        RUSAK_BERAT
    }

    class JenisAset {
        <<enumeration>>
        RUANG
        LAPTOP
        ALAT_LAB
    }

    class TingkatRisiko {
        <<enumeration>>
        RENDAH
        SEDANG
        TINGGI
    }

    class StatusPeminjaman {
        <<enumeration>>
        DIAJUKAN
        DISETUJUI
        DITOLAK
        DIBATALKAN
        DIPINJAM
        TERLAMBAT
        DIKEMBALIKAN
    }
}

namespace KONTRAK {
    class DapatDipinjam {
        <<interface>>
        +bisaDipinjam() boolean
    }

    class AturanDenda {
        <<interface>>
        +hitung(Aset aset, int hariTerlambat) long
    }
}

namespace JADWAL {
    class JadwalPeminjaman {
        -List~Peminjaman~ daftar
        -int kuotaLaptop
        +JadwalPeminjaman(int kuotaLaptop)
        #kuotaLaptop() int
        #daftarMutable() List~Peminjaman~
        +tambah(Peminjaman p) void
        +bentrok(Peminjaman baru) boolean
        +semuaUrutMulai() List~Peminjaman~
        +perAset() Map~String,List~ 
        +hapus(String id) boolean
        +ajukan(Peminjaman baru) void
    }
}

namespace KATALOG {
    class KatalogAset {
        -List~Aset~ daftar
        +KatalogAset()
        +tambah(Aset aset) void
        +semua() List~Aset~
        +cari(String kata) List~Aset~
        +cari(String kata, JenisAset jenis) List~Aset~
    }
}

namespace DENDA {
    class DendaFlat {
        +DendaFlat()
        +hitung(Aset aset, int hariTerlambat) long
    }

    class DendaProgresif {
        +DendaProgresif()
        +hitung(Aset aset, int hariTerlambat) long
    }

    class LayananDenda {
        -AturanDenda aturan
        +LayananDenda(AturanDenda aturan)
        +hitung(Aset aset, int hariTerlambat) long
    }
}

namespace FACTORY {
    class AsetFactory {
        <<final>>
        -AsetFactory()
        +buat(JenisAset jenis, String kode, String nama, String atribut) Aset
    }
}

namespace CONFIG {
    class Varian {
        <<final>>
        -int[] DENDA_PER_HARI
        -int[] BATAS_DURASI_JAM
        -int[] KUOTA_LAPTOP
        -Varian aktif
        +String nim
        +String nama
        +int dendaPerHari
        +int batasDurasiJam
        +int kuotaLaptop
        -Varian(String nim, String nama)
        +dariNim(String nim, String nama) Varian
        +aktif() Varian
    }
}

namespace EXCEPTION {
    class AsetPinjamException {
        +AsetPinjamException(String pesan)
        +AsetPinjamException(String pesan, Throwable sebab)
    }

    class PeminjamanBentrokException {
        +PeminjamanBentrokException()
    }

    class KuotaHabisException {
        +KuotaHabisException()
    }

    class StatusTidakSahException {
        +StatusTidakSahException()
    }

    class DataAksesException {
        +DataAksesException(String pesan, Throwable sebab)
    }
}

namespace DAO {
    class AsetDAO {
        <<interface>>
        +simpan(Aset aset) void
        +cariByKode(String kode) Optional~Aset~
        +semua() List~Aset~
        +perbarui(Aset aset) void
        +hapus(String kode) boolean
    }

    class PeminjamanDAO {
        <<interface>>
        +simpan(Peminjaman peminjaman) void
        +cariById(String id) Optional~Peminjaman~
        +perbaruiStatus(String id, StatusPeminjaman status) boolean
    }

    class JdbcAsetDAO {
        -Supplier~Connection~ sumberKoneksi
        +JdbcAsetDAO(Supplier~Connection~ sumberKoneksi)
        +simpan(Aset aset) void
        +cariByKode(String kode) Optional~Aset~
        +semua() List~Aset~
        +perbarui(Aset aset) void
        +hapus(String kode) boolean
    }

    class JdbcPeminjamanDAO {
        -Supplier~Connection~ sumberKoneksi
        -AsetDAO asetDao
        +JdbcPeminjamanDAO(Supplier~Connection~ sumberKoneksi, AsetDAO asetDao)
        +simpan(Peminjaman peminjaman) void
        +cariById(String id) Optional~Peminjaman~
        +perbaruiStatus(String id, StatusPeminjaman status) boolean
    }

    class Koneksi {
        <<final>>
        -Koneksi()
        +baru() Connection
    }
}

class RuntimeException {
    <<Java API>>
}

Aset ..|> DapatDipinjam
Aset <|-- Ruang
Aset <|-- Laptop
Aset <|-- AlatLab
AlatLab --> TingkatRisiko : tingkatRisiko

Peminjaman "1" --> "1" Peminjam : peminjam
Peminjaman "1" --> "1" Aset : aset
Peminjaman "1" --> "1" StatusPeminjaman : status
Peminjaman ..> StatusTidakSahException : throw

JadwalPeminjaman "1" o-- "0..*" Peminjaman : daftar
JadwalPeminjaman ..> PeminjamanBentrokException : throw
JadwalPeminjaman ..> KuotaHabisException : throw

KatalogAset "1" o-- "0..*" Aset : daftar
KatalogAset ..> JenisAset : filter cari

AturanDenda ..> Aset : parameter hitung
DendaFlat ..|> AturanDenda
DendaProgresif ..|> AturanDenda
LayananDenda "1" o-- "1" AturanDenda : aturan
LayananDenda ..> Aset : parameter hitung

AsetFactory ..> Aset : buat
AsetFactory ..> JenisAset
Aset ..> Varian : Varian.aktif()

AsetDAO <|.. JdbcAsetDAO
PeminjamanDAO <|.. JdbcPeminjamanDAO
JdbcPeminjamanDAO "1" o-- "1" AsetDAO : asetDao
AsetDAO ..> Aset
PeminjamanDAO ..> Peminjaman
PeminjamanDAO ..> StatusPeminjaman
JdbcAsetDAO ..> Aset
JdbcPeminjamanDAO ..> Peminjaman
Koneksi ..> DataAksesException

RuntimeException <|-- AsetPinjamException
AsetPinjamException <|-- PeminjamanBentrokException
AsetPinjamException <|-- KuotaHabisException
AsetPinjamException <|-- StatusTidakSahException
AsetPinjamException <|-- DataAksesException
